# Honoteca — environment. Copy to `.env` (git-ignored) and fill in.

# --- acceso (magic link por correo, con whitelist y biblioteca por usuario) ---------
# Correos autorizados (separados por coma). Cada correo tiene su PROPIA biblioteca.
# SIN esta variable (ni OWNER_EMAIL) la app queda ABIERTA en modo local.
# Al activarla, los libros que ya existían en local pasan al primer correo de la lista.
ALLOWED_EMAILS=

# Public registration is opt-in. Each verified email gets its own private library.
# Requires Resend, a verified sender, HTTPS APP_URL and Cloudflare Turnstile.
# PUBLIC_SIGNUP=1
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Secreto para firmar la cookie de sesión. Pon una cadena larga y aleatoria en producción.
# Sin él se usa uno de desarrollo (las sesiones se pierden al reiniciar el server).
AUTH_SECRET=

# Envío del enlace por Resend (https://resend.com). Sin API key, el enlace se imprime en el
# log del servidor en desarrollo. En producción no se generan enlaces sin proveedor.
RESEND_API_KEY=
# Remitente verificado en Resend (default: onboarding@resend.dev, que solo manda a tu correo).
# RESEND_FROM="Honoteca <hola@tudominio.com>"

# Base pública para el enlace del correo. Si no se pone, se deduce del request
# (respeta x-forwarded-proto de un reverse proxy).
# APP_URL=https://honoteca.app

# Detrás de un reverse proxy (Caddy/nginx) pon 1 para ver la IP real del cliente (rate limit
# del login) y el protocolo. Directo a internet, déjalo sin definir.
# TRUST_PROXY=1

# En producción el server exige login y AUTH_SECRET de al menos 32 caracteres.
# NODE_ENV=production

# --- metadatos (opcional) -----------------------------------------------------------
# Google Books API key — OPTIONAL, and off by default.
# With no value the source is left out of the lookup chain entirely: openbd + NDL +
# Open Library already cover Japanese books well, and a source you never asked is not
# a source that said no (so the scan screen stays quiet about it).
# Set it only if you want the 4th source. If a key IS set and still gets refused, the
# scan screen names the reason (quota reached / key not valid / API not enabled).
# Get one free (no card): https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# --- opcionales ---------------------------------------------------------------------
# Directorio único de datos persistentes (pone library.db y covers/ juntos; ideal para un volumen /data en Fly.io)
# DATA_DIR=/data
# PORT=8849
# HOST=0.0.0.0
